# ============================================================
# ZarinPal Payment Gateway (REST v4)
# ============================================================
#
# جریان پرداخت (ایجاد تراکنش → StartPay → تأیید) فقط از طریق REST v4
# زرین‌پال انجام می‌شود و با مرچنت‌کد احراز هویت می‌گردد.
#
# نکته: endpoint گراف‌کیوال زرین‌پال (zarinpal_graphql_url در core/config.py)
# صرفاً برای مدیریت حساب/پرس‌وجوی تراکنش‌ها با توکن OAuth 2.0 است و
# mutation برای ایجاد/تأیید پرداخت ندارد؛ بنابراین در جریان پرداخت استفاده نمی‌شود.
#
# توجه: طبق main.py، فایل .env هنگام اجرای لوکال از پوشه‌ی app/ (والدِ backend)
# خوانده می‌شود؛ این فایل صرفاً نمونه‌ی مقادیر موردنیاز است.

# مرچنت‌کد (شناسه پذیرنده) دریافت‌شده از پنل زرین‌پال
ZARINPAL_MERCHANT_ID=672da4a6-182c-4054-814d-2e7823c85195

# true = درگاه آزمایشی (sandbox) / false = درگاه واقعی
ZARINPAL_USE_SANDBOX=true

# آدرس عمومی سایت (بدون مسیر انتهایی) برای ساخت آدرس بازگشت از درگاه
# مثال: https://example.ir
PUBLIC_SITE_URL=

# (اختیاری) مسیر بازگشت از درگاه که سمت فرانت‌اند آن را هندل می‌کند
# ZARINPAL_CALLBACK_PATH=/payment/callback

# (اختیاری) متغیر قدیمی برای آدرس بازگشت؛ در اولویتِ دوم بعد از PUBLIC_SITE_URL
# ZARINPAL_CALLBACK_BASE_URL=
